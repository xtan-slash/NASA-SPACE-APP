{
  "name": "Crop",
  "description": "Configurable crop record. All parameter values are editable inputs and are demo illustrative values unless the source note says otherwise.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Crop name"
    },
    "local_name": {
      "type": "string",
      "description": "Local / common name"
    },
    "family": {
      "type": "string",
      "description": "Botanical family, used for rotation diversity"
    },
    "rotation_role": {
      "type": "string",
      "enum": [
        "cereal",
        "legume",
        "oilseed",
        "vegetable",
        "fodder",
        "cash"
      ],
      "enumColors": [
        "yellow",
        "green",
        "blue",
        "red",
        "purple",
        "pink"
      ],
      "description": "Role of the crop in the rotation"
    },
    "season": {
      "type": "string",
      "enum": [
        "kharif",
        "rabi",
        "summer"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow"
      ],
      "description": "Season the crop is normally grown in"
    },
    "duration_days": {
      "type": "number",
      "description": "Typical crop duration in days (informational)"
    },
    "water_need_mm": {
      "type": "number",
      "description": "Seasonal crop water demand in mm"
    },
    "ph_min": {
      "type": "number",
      "description": "Lower pH of the suitable range"
    },
    "ph_max": {
      "type": "number",
      "description": "Upper pH of the suitable range"
    },
    "temp_opt_min": {
      "type": "number",
      "description": "Lower bound of optimum mean temperature range, \u00b0C"
    },
    "temp_opt_max": {
      "type": "number",
      "description": "Upper bound of optimum mean temperature range, \u00b0C"
    },
    "heat_threshold_c": {
      "type": "number",
      "description": "Daily maximum temperature counted as heat stress, \u00b0C"
    },
    "oc_need": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "description": "Organic-carbon demand level; maps to 0.45 / 0.65 / 0.85 % thresholds"
    },
    "texture_preferred": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Soil texture classes scored as fully suitable"
    },
    "texture_marginal": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Soil texture classes scored as marginal"
    },
    "n_fixing": {
      "type": "boolean",
      "description": "Legume (biological nitrogen fixing)"
    },
    "flood_sensitive": {
      "type": "boolean",
      "description": "Crop is sensitive to heavy-rain / waterlogging days"
    },
    "source_note": {
      "type": "string",
      "description": "Where the parameter values came from, or an explicit demo-value warning"
    },
    "notes": {
      "type": "string",
      "description": "Agronomic notes"
    },
    "is_demo": {
      "type": "boolean",
      "description": "True when parameters are illustrative demo values"
    }
  },
  "required": [
    "name",
    "water_need_mm",
    "ph_min",
    "ph_max"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}